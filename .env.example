PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# Required by P2 semantic/hybrid retrieval and on-demand note assets, whose
# RPCs are service-only. Use the modern sb_secret_... server key. It is also required once the
# lock_mcp_rpc_to_service_role migration is applied: /mcp calls the mcp_* RPCs
# with this key instead of the anon key, so revoking anon's EXECUTE makes the
# route the only way to reach them.
# Server-only — never expose it to the browser, never prefix it with PUBLIC_.
SUPABASE_SECRET_KEY=

# Legacy fallback during migration; new deployments should use
# SUPABASE_SECRET_KEY above.
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2 (S3-compatible), used to store uploaded photos and audio
# recordings under a per-user key prefix. The server only ever mints
# presigned PUT/GET URLs with these — it never proxies file bytes itself.
# Server-only — never expose these to the browser.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
