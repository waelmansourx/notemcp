PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# Optional today, required once the lock_mcp_rpc_to_service_role migration is
# applied: /mcp calls the mcp_* RPCs with this key instead of the anon key, so
# revoking anon's EXECUTE makes the route the only way to reach them.
# Server-only — never expose it to the browser, never prefix it with PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
